<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Hàng trên: Ảnh bên trái + Thông tin & Tiêu đề bên phải -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <!-- Card bo góc bọc ImageView để bo tròn ảnh đẹp mắt -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="92dp"
            android:layout_height="70dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/card_border"
            app:strokeWidth="1dp">

            <ImageView
                android:id="@+id/ivNewsThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="News thumbnail"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_image_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Cột thông tin bài viết bên phải -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Dòng Metadata: Mã tin • Thể loại • Ngày đăng -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvNewsCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TT-1082"
                    android:textColor="#15803D"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="•"
                    android:textColor="@color/text_caption"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvNewsCategory"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ô tô - Xe máy"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="•"
                    android:textColor="@color/text_caption"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvNewsDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12/11/2026"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Tiêu đề bài viết (tối đa 2 dòng) -->
            <TextView
                android:id="@+id/tvNewsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:text="Mẫu B-SUV Nhật Bản này được giảm hơn 200 triệu đồng cạnh tranh phân khúc"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hàng nút hành động: Sửa & Xóa (căn về bên phải) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <!-- Nút Sửa -->
        <LinearLayout
            android:id="@+id/btnEditNews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_btn_action_edit"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Edit"
                android:src="@drawable/ic_edit"
                app:tint="@color/btn_edit_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sửa"
                android:textColor="@color/btn_edit_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Nút Xóa -->
        <LinearLayout
            android:id="@+id/btnDeleteNews"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_action_delete"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="14dp"
            android:paddingBottom="5dp">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Delete"
                android:src="@drawable/ic_delete"
                app:tint="@color/btn_delete_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xóa"
                android:textColor="@color/btn_delete_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Đường viền kẻ ngang phân cách mỏng nhẹ giữa các bài viết -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider_color" />

</LinearLayout>
