<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_font_size_dialog"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chọn cỡ chữ"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCloseFontSize"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="×"
            android:textColor="@color/text_muted"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/btnSmallFont"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_font_size_button"
            android:gravity="center"
            android:text="Aa"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/fontSizeSeekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:max="3"
            android:progress="0"
            android:progressTint="#D81B60"
            android:thumbTint="@color/white" />

        <TextView
            android:id="@+id/btnLargeFont"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_font_size_button"
            android:gravity="center"
            android:text="Aa"
            android:textColor="@color/text_secondary"
            android:textSize="19sp" />
    </LinearLayout>
</LinearLayout>
